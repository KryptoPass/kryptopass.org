---
import Layout from '../layouts/Layout.astro';

const github = 'https://github.com/KryptoPass';
const app = `${github}/KryptoPass`;
const discord = 'https://discord.gg/aNxcgzfwKG';

const features = [
	{
		title: 'One vault for everything',
		text: 'Logins, notes, TOTP codes, SSH keys, Wi-Fi networks, cards, identities, licenses and custom fields, organized in folders with version history.',
	},
	{
		title: 'Encryption you control',
		text: 'Entries are encrypted with OpenPGP using your own key. Your keys live in your GnuPG keyring, not in someone else’s cloud.',
	},
	{
		title: 'Encrypted backups',
		text: 'Back up the whole vault to a single encrypted .kpb file, choose who can open it, and restore it when you need to.',
	},
	{
		title: 'Private search',
		text: 'Find a login instantly. The search index is kept in protected memory while the vault is open.',
	},
	{
		title: 'Locks when you step away',
		text: 'The vault locks with your session, when the computer suspends, or after a period of inactivity. The clipboard clears itself.',
	},
	{
		title: 'At home on KDE Plasma',
		text: 'A native Qt 6 and Kirigami app that follows your theme, with configurable shortcuts, browser integration and import from Proton Pass.',
	},
];

const steps = [
	{ title: 'You create an entry', text: 'A login, a note, a key: whatever you need to keep safe.' },
	{ title: 'OpenPGP encrypts it', text: 'With your GnuPG key, on your device, before anything is written.' },
	{ title: 'It stays with you', text: 'The result is saved in a local database. No server needs your secrets.' },
];

const repos = [
	{ name: 'KryptoPass', href: app, text: 'Desktop app for KDE Plasma (Rust, Qt 6, Kirigami).' },
	{ name: 'kryptopass-core', href: `${github}/kryptopass-core`, text: 'Rust core without UI: vault, OpenPGP, pairing and sync.' },
	{ name: 'kryptopass-relay', href: `${github}/kryptopass-relay`, text: 'Signaling relay for connections over the Internet. It never sees vault data or keys.' },
];
---

<Layout>
	<header class="nav">
		<div class="wrap nav-inner">
			<a class="brand" href="/">KryptoPass</a>
			<nav aria-label="Main">
				<a href="#features">Features</a>
				<a href="#security">Security</a>
				<a class="optional" href="#status">Status</a>
				<a href={github}>GitHub</a>
			</nav>
		</div>
	</header>

	<main>
		<section class="hero">
			<div class="wrap">
				<p class="eyebrow">Your digital fortress of secrets</p>
				<h1>Passwords and secure notes, encrypted with OpenPGP, on devices you control.</h1>
				<p class="lead">
					KryptoPass is a free, open-source password manager. Every entry is encrypted with your own GnuPG key
					before it is saved, and the vault stays on your devices. No account and no cloud required.
				</p>
				<div class="actions">
					<a class="button primary" href={app}>View on GitHub</a>
					<a class="button" href={`${app}/blob/main/BUILD.md`}>Build from source</a>
				</div>
				<p class="meta">Desktop app for KDE Plasma · GPL-3.0-or-later · Early development</p>
			</div>
		</section>

		<section id="features" class="section">
			<div class="wrap">
				<h2>Everything you keep, in its place</h2>
				<p class="section-lead">More than a list of passwords: one vault for the secrets of your everyday life.</p>
				<ul class="grid">
					{features.map((feature) => (
						<li class="card">
							<h3>{feature.title}</h3>
							<p>{feature.text}</p>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section id="security" class="section soft">
			<div class="wrap">
				<h2>Security that doesn’t depend on a cloud</h2>
				<ol class="steps">
					{steps.map((step, index) => (
						<li>
							<span class="step-number" aria-hidden="true">{index + 1}</span>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</li>
					))}
				</ol>

				<div class="split">
					<div>
						<h3>Pairing without trusting a server</h3>
						<p>
							Devices connect with the Noise XX protocol and a short code you compare yourself. Devices you have
							already authorized reconnect without repeating the ritual. The signaling relay only routes messages
							between them.
						</p>
					</div>
					<div>
						<h3>Upfront about the details</h3>
						<p>
							Names and folders are encrypted in every stored version. To list and search the vault, each device
							keeps a local index with that information unencrypted, alongside the fingerprints of the recipients.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section id="status" class="section">
			<div class="wrap">
				<h2>Project status</h2>
				<div class="notice" role="note">
					<p>
						<strong>KryptoPass is in early development (0.1.0).</strong> The desktop vault, import, backups and
						desktop integration are ready to use. Android pairing, the Internet transport and sync are experimental
						and have not yet had an independent security review.
					</p>
				</div>

				<h3 class="sub">Open source, in the open</h3>
				<ul class="repos">
					{repos.map((repo) => (
						<li>
							<a href={repo.href}>{repo.name}</a>
							<span>{repo.text}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="section soft">
			<div class="wrap cta">
				<h2>Your collaboration is welcome</h2>
				<p>
					Found a bug, have an idea, or want to help? Open an <a href={`${app}/issues`}>issue</a>, send a pull
					request, or come say hello on <a href={discord}>Discord</a>.
				</p>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="wrap footer-inner">
			<p>
				<strong>KryptoPass</strong>, from the Greek <em>kryptós</em> (“secret”) and <em>pass</em>.
			</p>
			<p>
				<a href="mailto:support@kryptopass.org">support@kryptopass.org</a> ·
				<a href={discord}>Discord</a> ·
				<a href={github}>GitHub</a>
			</p>
			<p class="fine">
				© 2026 KryptoPass contributors · GPL-3.0-or-later. KryptoPass is an independent project and is not part of KDE.
			</p>
		</div>
	</footer>
</Layout>

<style>
	.wrap {
		width: 100%;
		max-width: var(--max);
		margin: 0 auto;
		padding: 0 1.25rem;
	}

	.nav {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: saturate(160%) blur(10px);
		border-bottom: 1px solid var(--line);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 3.75rem;
	}

	.brand {
		font-weight: 700;
		font-size: 1.125rem;
		color: var(--text);
		text-decoration: none;
		letter-spacing: -0.01em;
	}

	.nav nav {
		display: flex;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	.nav nav a {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.nav nav a:hover {
		color: var(--text);
	}

	@media (max-width: 30rem) {
		.nav nav {
			gap: 0.9rem;
			flex-wrap: nowrap;
		}

		.nav nav a {
			font-size: 0.9rem;
		}

		.nav nav .optional {
			display: none;
		}
	}

	.hero {
		padding: clamp(4rem, 10vw, 7.5rem) 0 clamp(3.5rem, 8vw, 6rem);
	}

	.eyebrow {
		color: var(--accent);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.02em;
		margin-bottom: 1rem;
	}

	.hero h1 {
		font-size: clamp(2.1rem, 5.2vw, 3.6rem);
		font-weight: 750;
		max-width: 22ch;
	}

	.lead {
		margin-top: 1.5rem;
		font-size: clamp(1.1rem, 2vw, 1.25rem);
		color: var(--muted);
		max-width: 46rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.875rem;
		padding: 0 1.35rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		color: var(--text);
		background: var(--bg);
		font-weight: 600;
		text-decoration: none;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	.button:hover {
		border-color: var(--accent);
		color: var(--text);
	}

	.button.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}

	.button.primary:hover {
		background: var(--accent-strong);
		border-color: var(--accent-strong);
		color: var(--on-accent);
	}

	.meta {
		margin-top: 1.5rem;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.section {
		padding: clamp(3.5rem, 8vw, 5.5rem) 0;
	}

	.section.soft {
		background: var(--bg-soft);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.section h2 {
		font-size: clamp(1.6rem, 3.4vw, 2.25rem);
		font-weight: 700;
	}

	.section-lead {
		margin-top: 0.75rem;
		color: var(--muted);
		max-width: 40rem;
	}

	.grid {
		list-style: none;
		padding: 0;
		margin: 2.5rem 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.5rem), 1fr));
		gap: 1rem;
	}

	.card {
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.5rem;
	}

	.card h3,
	.steps h3,
	.split h3 {
		font-size: 1.1rem;
		font-weight: 650;
		margin-bottom: 0.5rem;
	}

	.card p,
	.steps p,
	.split p {
		color: var(--muted);
		font-size: 0.98rem;
	}

	.steps {
		list-style: none;
		padding: 0;
		margin: 2.5rem 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: 1rem;
	}

	.steps li {
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.5rem;
	}

	.step-number {
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent);
		font-weight: 700;
		font-size: 0.95rem;
		margin-bottom: 0.9rem;
	}

	.split {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: 2rem;
		margin-top: 3rem;
	}

	.notice {
		margin-top: 1.75rem;
		background: var(--warn-bg);
		border: 1px solid var(--warn-line);
		border-radius: var(--radius);
		padding: 1.25rem 1.5rem;
		max-width: 50rem;
	}

	.sub {
		margin-top: 3rem;
		font-size: 1.2rem;
		font-weight: 650;
	}

	.repos {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
		border-top: 1px solid var(--line);
	}

	.repos li {
		display: grid;
		grid-template-columns: minmax(10rem, 14rem) 1fr;
		gap: 0.25rem 1.5rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--line);
	}

	.repos a {
		font-weight: 600;
		text-decoration: none;
	}

	.repos span {
		color: var(--muted);
	}

	@media (max-width: 36rem) {
		.repos li {
			grid-template-columns: 1fr;
		}
	}

	.cta {
		max-width: 44rem;
		text-align: center;
	}

	.cta p {
		margin-top: 1rem;
		color: var(--muted);
	}

	.footer {
		padding: 2.5rem 0 3rem;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.footer-inner {
		display: grid;
		gap: 0.5rem;
	}

	.footer strong {
		color: var(--text);
	}

	.fine {
		font-size: 0.85rem;
	}
</style>
